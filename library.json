{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "liblog-sw",
  "version": "1.0.0",
  "description": "Simple logging library, suitable for every platform",
  "keywords": [
    "embedded",
    "logging-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eagletrt/liblog-sw"
  },
  "authors": [
    {
      "name": "Mirko Lana",
      "email": "mirko.lana@eagletrt.it",
      "maintainer": true
    }
  ],
  "license": "AGPL-3.0-only",
  "frameworks": "*",
  "platforms": "*",
  "dependencies": [
    {
      "name": "LibEagleTrt",
      "version": "https://github.com/eagletrt/libeagletrt-sw.git#v0.1.0"
    }
  ],
  "headers": [
    "logger.h",
    "logger-api.h"
  ],
  "examples": [],
  "export": {
    "include": [
      "src/**",
      "include/**"
    ]
  },
  "build": {
    "flags": "-std=gnu23"
  }
}
